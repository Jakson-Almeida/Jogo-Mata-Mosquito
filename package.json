{
  "name": "jogo-mata-mosquito",
  "private": true,
  "description": "Jogo Mata Mosquito — React + Node",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n client,server -c green,cyan \"npm run dev -w client\" \"npm run dev -w server\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "preview": "npm run preview -w client"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
